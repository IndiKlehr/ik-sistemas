# ============================================================
# IK SISTEMAS — Seguridad y cabeceras HTTP
# Colocar en la raíz del sitio
# ============================================================

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
  # Evita clickjacking (que te embeban en un iframe)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Evita MIME sniffing (que interpreten un .txt como .js)
  Header always set X-Content-Type-Options "nosniff"

  # Fuerza HTTPS por 1 año
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # No filtrar la URL de origen
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Bloquear permisos innecesarios
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # CSP: solo permitir scripts de tu propio dominio + CDN de Tailwind y Three.js
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://ajax.googleapis.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://wa.me; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- Bloquear acceso a archivos sensibles ---
<FilesMatch "(^\.|README\.md|package\.json|\.env|\.git|\.htaccess|\.htpasswd|composer\.(json|lock)|yarn\.lock)$">
  Require all denied
</FilesMatch>

# --- Bloquear navegación de directorios ---
Options -Indexes

# --- Página 404 personalizada ---
ErrorDocument 404 /404.html

# --- Forzar HTTPS (descomentar si ya tenés certificado SSL) ---
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Forzar WWW o no-WWW (elegí uno) ---
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- Compresión GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Caché de assets estáticos ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# --- Bloquear métodos HTTP inseguros ---
<LimitExcept GET POST HEAD OPTIONS>
  Require all denied
</LimitExcept>